# 构建产物
.gradle/
.kotlin/
build/
local.properties
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# 签名证书绝不入库，单独备份
keystore/
*.jks
*.keystore

# 航图 PDF 不入库（约 1.2 GB，由使用者自行准备），测试夹具除外
*.pdf
!app/src/test/resources/*.pdf
# 检查单页随附的两份手册随仓库分发，clone 后直接可打包：
#   a320_normal_checklist.pdf / juneyao_qrh.pdf
!app/src/main/assets/docs/*.pdf
!app/src/main/assets/docs/.gitkeep

# WorkBuddy 本地项目数据，不随仓库分发
.workbuddy/

# 容器与安装包
*.apk
*.aab
*.zip
*.tar.gz

# 编辑器
.vscode/
*.swp

# 临时
_tmp/

# ---- Navigraph / Jeppesen 受限数据：绝不入库 ----
# cycle_info.txt 明确写明 may not be copied, modified, published, sold or
# distributed，仅供个人本地模拟使用。仓库是公开的，一旦 commit 即构成公开分发。
#
# X-Plane 导航数据：解压产物约 217 MB / 1.7 万个 .dat，只留本机
# 压缩包 *.zip 已由上面的规则忽略
navData/

# 公司航路 .fms（同样来自 Navigraph 派生数据）
co-routes/

# 按扩展名兜底：导航数据散落别处时也不会误提交
*.dat
*.fms
*.fms.bak
